{
  "mcpServers": {
    "databaseContext": {
      "type": "stdio",
      "command": "C:/path/to/module-4-6-python/.venv/Scripts/python.exe",
      "args": ["-m", "database_context.mcp_server"],
      "cwd": "C:/path/to/module-4-6-python",
      "env": {
        "CONTEXT_API_URL": "http://127.0.0.1:8000",
        "CONTEXT_API_KEY": "${CONTEXT_API_KEY}"
      },
      "tools": [
        "list_schema_tables",
        "get_table_columns",
        "get_table_constraints",
        "get_table_indexes",
        "get_table_ddl"
      ]
    }
  }
}
